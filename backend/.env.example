# ─── Environment ─────────────────────────────────────────────
# development | test | staging | production. Production-like values
# (staging/production) enable startup hardening: a durable carousel
# checkpointer (CAROUSEL_CHECKPOINT_BACKEND=postgres) and a configured
# default image-provider key are required at boot (fail-fast).
ENVIRONMENT=development

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@localhost:5432/rag_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ─── Authentication ──────────────────────────────────────────
SECRET_KEY=                                   # REQUIRED: generate via `openssl rand -hex 32`
ANON_SECRET_KEY=                              # REQUIRED: generate via `openssl rand -hex 32`
ACCESS_TOKEN_EXPIRE_MINUTES=60
ANON_TOKEN_EXPIRE_MINUTES=60

# ─── AI Providers ────────────────────────────────────────────
OPENAI_API_KEY=                               # Optional: set to enable GPT features
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

ANTHROPIC_API_KEY=                            # Optional: set to enable Claude features
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=                               # Default image provider (IMAGE_MODEL_DEFAULT=gemini); REQUIRED in production-like ENVIRONMENT or startup fails (AE-0215)

# ─── Vector Store ────────────────────────────────────────────
PINECONE_API_KEY=                             # Optional: set to enable RAG features
PINECONE_INDEX_NAME=rag-index
PINECONE_ENVIRONMENT=us-east-1

# ─── LangSmith Observability ─────────────────────────────────
LANGSMITH_API_KEY=                            # Optional: set to enable LangSmith tracing
LANGSMITH_PROJECT=rag-backend
LANGSMITH_TRACING=false

# ─── LangFuse Observability ──────────────────────────────────
LANGFUSE_SECRET_KEY=                          # Optional: set to enable LangFuse tracing
LANGFUSE_PUBLIC_KEY=                          # Public key from LangFuse project settings
LANGFUSE_BASE_URL=http://localhost:3001       # Browser / local dev URL
LANGFUSE_HOST=http://langfuse:3000            # Docker internal URL (overrides BASE_URL in compose)

# ─── Server ──────────────────────────────────────────────────
DEBUG=false
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=*

# ─── Search ──────────────────────────────────────────────────
DEFAULT_SEARCH_ALPHA=0.5
DEFAULT_TOP_K=5
MAX_CHUNKS_PER_DOCUMENT=1000
MAX_UPLOAD_SIZE_MB=50

# ─── Carousel Generator ──────────────────────────────────────
CAROUSEL_OUTPUT_DIR=./output/carousels
# memory/disabled are non-durable and rejected when ENVIRONMENT is
# production-like. Prod MUST set CAROUSEL_CHECKPOINT_BACKEND=postgres plus
# CAROUSEL_CHECKPOINT_POSTGRES_URL so workflow state survives restarts (AE-0213).
CAROUSEL_CHECKPOINT_BACKEND=sqlite
CAROUSEL_CHECKPOINT_SQLITE_PATH=./output/carousel_checkpoints.sqlite
CAROUSEL_CHECKPOINT_POSTGRES_URL=
CAROUSEL_CHECKPOINT_TTL_DAYS=30
# Prod sets this to https://marinssolutions.com (AE-0359) so Meta can fetch slides.
CAROUSEL_PUBLIC_BASE_URL=

# ─── Writing Style ───────────────────────────────────────────
WRITING_STYLE_URLS=
WRITING_STYLE_CACHE_DIR=./output/writing_style_cache

# ─── Meta / Instagram Publishing ─────────────────────────────
META_IG_ACCESS_TOKEN=
META_IG_USER_ID=
# Fernet key for integration_credentials (AE-0358). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty disables autopilot Instagram publishing and logs a startup warning.
CREDENTIALS_ENCRYPTION_KEY=

# ─── GrokBot autopilot (AE-0351) ─────────────────────────────
# SHA-256 hex digest of the host scout's API key. The plaintext key is never
# stored on the server. Leave empty to disable /api/autopilot/* (HTTP 503).
#   python -c "import hashlib; print(hashlib.sha256(b'choose-a-key').hexdigest())"
GROKBOT_API_KEY_SHA256=

# AE-0352 signal collectors. Keep the resolver at "none": that path never
# requests x.com or a mirror. AUTOPILOT_X_MIRROR_HOST is a hostname, used
# only when the resolver is "mirror". GITHUB_TOKEN is optional.
AUTOPILOT_X_RESOLVER=none
AUTOPILOT_X_MIRROR_HOST=
GITHUB_TOKEN=

# AE-0355 owner notifications. Leave both empty to disable Telegram:
# the notifier logs and does not call the Bot API, and a run that
# reaches final review escalates with reason notifier_unconfigured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
# AE-0356: Telegram sends this in X-Telegram-Bot-Api-Secret-Token.
# Empty rejects every webhook call. Set it, then run
# python -m rag_backend.modules.autopilot.scripts.set_webhook <public-url>
TELEGRAM_WEBHOOK_SECRET=
# AE-0354 / AE-0359: the worker runs the autopilot only when this is true.
# Prod deploy.yml defaults it to false until the rollout flip.
AUTOPILOT_ENABLED=false
# Existing user id created carousels are owned by. Empty fails a queued run
# with owner_unconfigured and does not insert a project.
AUTOPILOT_OWNER_USER_ID=
# Queued autopilot runs allowed per America/Sao_Paulo day.
AUTOPILOT_DAILY_CAP=1
# AE-0370: what Approve does on Telegram. "now" offers Publicar agora / Agendar;
# "next_slot" schedules the next slot (12:00, 18:00, 21:00 America/Sao_Paulo).
AUTOPILOT_DEFAULT_PUBLISH=now

# ─── GrokBot image bridge (AE-0393, ADR-0022) ────────────────
# Carousel images through the Grok Bot webhook instead of the OpenAI Images
# API. Off here; prod deploy.yml turns it on (owner decision 2026-10-15). When
# true but GROKBOT_IMAGE_WEBHOOK_URL or IMAGE_BRIDGE_PUBLIC_BASE_URL is empty,
# startup logs image_bridge_misconfigured and keeps plain OpenAI. Contract:
# docs/architecture/grokbot-image-bridge.md
IMAGE_BRIDGE_ENABLED=false
# On any bridge failure (webhook down, refusal, timeout) call OpenAI instead.
IMAGE_BRIDGE_FALLBACK_ENABLED=true
# Per image, including the Grok Bot queue wait.
IMAGE_BRIDGE_TIMEOUT_SECONDS=600
# Bridge jobs in flight per backend process.
IMAGE_BRIDGE_MAX_CONCURRENCY=1
# Public origin that builds callback_url (…/api/v1/image-bridge/jobs/{id}/result).
IMAGE_BRIDGE_PUBLIC_BASE_URL=
# Secret: the Grok Bot (Cursor) webhook URL.
GROKBOT_IMAGE_WEBHOOK_URL=
# Auth header sent to the webhook; the value is a secret (e.g. "Bearer …").
# An empty value sends no auth header.
GROKBOT_IMAGE_WEBHOOK_AUTH_HEADER=Authorization
GROKBOT_IMAGE_WEBHOOK_AUTH_VALUE=

# ─── App Info ────────────────────────────────────────────────
APP_NAME=RAG Backend
APP_VERSION=0.1.0
